{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanHandoff",
  "type": "object",
  "required": [
    "workflow_id",
    "plan_id",
    "scope",
    "goal",
    "requirements",
    "tasks",
    "path",
    "revision",
    "status"
  ],
  "properties": {
    "workflow_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["draft", "approved", "superseded"]
    },
    "scope": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "files",
          "implementation",
          "verification",
          "done_when"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implementation": {
            "type": "string"
          },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "done_when": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}