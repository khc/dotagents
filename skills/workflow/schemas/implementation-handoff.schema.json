{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImplementationHandoff",
  "type": "object",
  "required": [
    "workflow_id",
    "implementation_id",
    "source",
    "scope",
    "status",
    "touched_files",
    "verification"
  ],
  "properties": {
    "workflow_id": {
      "type": "string"
    },
    "implementation_id": {
      "type": "string"
    },
    "source": {
      "enum": [
        "feature",
        "refactor",
        "bug",
        "implement"
      ]
    },
    "plan_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "needs_plan",
        "replan",
        "blocked"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "base_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "head_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "touched_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preexisting_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "change_boundary": {
      "type": "string"
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "feature"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "success",
              "needs_plan",
              "blocked"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "refactor"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "success",
              "blocked"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "bug"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "success",
              "blocked"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "implement"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "success",
              "replan",
              "blocked"
            ]
          }
        }
      }
    }
  ]
}