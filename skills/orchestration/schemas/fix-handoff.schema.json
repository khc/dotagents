{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FixHandoff",
  "type": "object",
  "required": [
    "workflow_id",
    "fix_uuid",
    "review_uuid",
    "scope",
    "status",
    "findings_fixed",
    "verification"
  ],
  "properties": {
    "workflow_id": {
      "type": "string"
    },
    "fix_uuid": {
      "type": "string"
    },
    "review_uuid": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "review_mode": {
      "enum": [
        "change",
        "path",
        "symbol"
      ]
    },
    "target_symbol": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "success",
        "diagnosis_mismatch",
        "blocked"
      ]
    },
    "findings_fixed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "touched_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}