{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImplementationHandoff",
  "type": "object",
  "required": [
    "workflow_id",
    "implementation_id",
    "source",
    "scope",
    "status",
    "touched_files",
    "verification"
  ],
  "properties": {
    "workflow_id": {
      "type": "string"
    },
    "implementation_id": {
      "type": "string"
    },
    "source": {
      "enum": [
        "feature",
        "implement"
      ]
    },
    "plan_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "needs_plan",
        "replan",
        "blocked"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "base_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "head_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "touched_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preexisting_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "change_boundary": {
      "type": "string"
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}