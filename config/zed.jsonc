// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "git_panel": {
    "tree_view": true,
    "button": true,
    "dock": "left"
  },
  "project_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
    "commit_message_instructions": "Generate a Git commit message from the provided diff.\n\n- Follow Conventional Commits 1.0.0 exactly: `<type>[optional scope][optional !]: <description>`.\n- Use only these commit types: feat, fix, refactor, perf, docs, test, build, ci, chore, style.\n- Choose the type that best represents the overall purpose of the change.\n- If the diff spans multiple unrelated changes, choose the type and scope of the primary or highest-impact change; do not invent a combined or generic type to cover everything.\n- Use `style` exclusively for formatting or whitespace changes that do not affect behavior. Use `refactor` for structural changes that preserve behavior.\n- Add a scope only when it can be inferred confidently from the changed code. The scope must be a concise noun describing the affected part of the codebase. Avoid generic scopes such as `core`, `misc`, or `general` unless they are actual module names.\n- Use lowercase for the type, scope, and first letter of the description, except for proper nouns or acronyms.\n- Start the description with a lowercase imperative verb (e.g., add, fix, remove, update, simplify, extract). Describe what the commit accomplishes, not what was done.\n- Do not end the subject line with a period.\n- Keep the subject line, including type and scope, at most 71 characters.\n- Focus on the intent and overall purpose of the change, not low-level implementation details.\n- For breaking changes, add `!` immediately before the colon. Include a `BREAKING CHANGE: <description>` footer when the compatibility impact or required migration steps need explanation. Separate the footer from the subject or body with exactly one blank line.\n- Add a body only when it provides important context that cannot be expressed clearly in the subject.\n- If a body is included, leave exactly one blank line after the subject and use concise bullet points, each wrapped at roughly 72 characters.\n- In the body, describe why the change was made or important behavioral consequences, not a file-by-file summary.\n- Do not invent information that cannot be inferred from the diff.\n- Output exactly one commit message.\n- Output only the commit message. Do not include Markdown, code fences, labels, alternatives, explanations, or commentary.",
    "commit_message_include_project_rules": false
  },
  "cli_default_open_behavior": "new_window",
  "icon_theme": {
    "mode": "light",
    "light": "Bearded Icon Theme",
    "dark": "Zed (Default)",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
      },
      "type": "registry",
    },
  },
  "base_keymap": "VSCode",
  "ui_font_size": 15,
  "ui_font_family": ".SystemUIFont",
  "agent_ui_font_size": 15,
  "agent_ui_font_family": ".SystemUIFont",
  "agent_buffer_font_size": 13,
  "agent_buffer_font_family": ".SystemUIFont",
  "buffer_font_size": 14,
  "buffer_font_family": "Source Code Pro",
  "theme": {
    "mode": "light",
    "light": "Bearded Theme Light",
    "dark": "One Dark",
  }
}
